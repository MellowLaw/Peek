{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peek",
  "version": "0.3.4",
  "identifier": "com.mellowlaw.peek",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Peek",
      "width": 620,
      "height": 520,
      "visible": false,
      "decorations": false,
      "transparent": true,
      "shadow": false,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "resizable": false,
      "focus": false,
      "focusable": false,
      "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --disable-component-update --disable-sync"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "MellowLaw",
    "copyright": "Copyright (c) 2026 Lawrence (MellowLaw)",
    "shortDescription": "Top-edge utility notch for Windows",
    "licenseFile": "../TERMS.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDNUQ1Mzk0M0Y3Q0I4MDcKUldRSHVIdy9sRk5kcklGRFFpenpkaTFNTkhWQkZlL1cyTGFnMzhmQnZtRHhOeWFkSm8wL3pDUWUK",
      "endpoints": [
        "https://github.com/MellowLaw/Peek/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
